{
  "name": "client-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client Mode local-first delivery layer (toolkit implementation).",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:tasks": "node --import tsx --test tests/tasks/*.test.ts",
    "test:reference": "node --test tests/reference.test.mjs",
    "test": "npm run typecheck && npm run test:reference && npm run test:install && npm run test:tasks",
    "cm": "node --import tsx apps/cli/src/cm.ts",
    "test:install": "node --import tsx --test tests/install/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "axe-core": "^4.11.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "bin": {
    "cm": "./bin/cm.mjs"
  }
}
